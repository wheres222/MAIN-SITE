SELLAUTH_SHOP_ID=your_shop_id_here
SELLAUTH_API_KEY=your_api_key_here
SELLAUTH_API_BASE_URL=https://api.sellauth.com

# Emergency lock switch (set true to immediately pause checkout)
CHECKOUT_FORCE_DISABLE=false

# Optional comma-separated image hosts (HTTPS only)
# Example: api.sellauth.com,cdn.yourdomain.com,**.mysellauth.com
NEXT_IMAGE_REMOTE_HOSTS=api.sellauth.com,**.mysellauth.com

NEXT_PUBLIC_DISCORD_URL=https://discord.gg/yourserver
NEXT_PUBLIC_SUPPORT_URL=https://discord.gg/yourserver

# reselling.pro delivery API key — SERVER ONLY, never prefix with NEXT_PUBLIC_
# Set this in Cloudflare Pages > Settings > Environment Variables (or Workers secrets)
# For local dev only: add to .env.local (never commit .env.local)
DELIVERY_API_KEY=your_delivery_api_key_here

# REQUIRED: SellAuth webhook secret for signature verification
# Generate a random string, paste it here AND in SellAuth dashboard > Webhooks > Secret
# Webhooks are blocked until this is set.
SELLAUTH_WEBHOOK_SECRET=your_webhook_secret_here

# ─── KeyHub — automatic product status feed ─────────────────────────────────
# API key ("kh_…") — SERVER ONLY, never prefix with NEXT_PUBLIC_
# Powers the live status board. Read from GET {KEYHUB_API_BASE}/products, which
# returns each product's operationalStatus (operational | maintenance |
# degraded | use-at-own-risk). Auth is "Authorization: Bearer <key>".
# Manual overrides in /admin/status always win over this feed.
# Note: KeyHub's POST /key-status (scope keys:status) is a single-licence-key
# lookup and cannot drive product statuses — see src/lib/keyhub.ts.
KEYHUB_API_KEY=kh_your_keyhub_api_key_here
# Optional override of the KeyHub API base. Must NOT include a trailing path
# segment — the client appends "/products". Leave unset to use the default.
KEYHUB_API_BASE=https://keyhub.club/api/external

# ─── Email Notifications (Resend) ───────────────────────────────────────────
# Sign up at https://resend.com — get your API key from the dashboard
# If unset, email notifications are skipped (dev/staging only)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=CheatParadise <noreply@yourdomain.com>

# ─── Error Tracking (optional) ──────────────────────────────────────────────
# Sign up at https://sentry.io — DSN found in Project Settings > Client Keys
SENTRY_DSN=https://your_key@sentry.io/your_project_id

# ─── Supabase (user accounts, auth, database) ───────────────────────────────
# Create a free project at https://supabase.com
# Find these in: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key — SERVER ONLY, never prefix with NEXT_PUBLIC_
# Required for the /admin/status panel and /api/status-feed Supabase source.
# Find it in: Project Settings > API > Service role key (keep this secret!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Admin bootstrap email — BOOTSTRAP ONLY.
# Roles now live in profiles.role (user | staff | owner) and are managed at
# /admin/users. This env var grants owner access when no profile row has
# role='owner' yet, so a fresh database can't lock you out. Once you've set
# yourself to owner in the DB, this can be removed.
ADMIN_EMAIL=your_admin_email@example.com

# Optional: API key for bot/script status pushes (PUT /api/status/:ref)
STATUS_API_KEY=your_random_secret_key_here

# Leave blank to disable analytics entirely
# Server-only read key for the /admin/traffic dashboard. This is a *personal*
# public ingest key above. Never prefix it with NEXT_PUBLIC_.

# Maintenance-mode bypass token. While MAINTENANCE_MODE is on in src/proxy.ts,
# visiting ?preview=<this> sets a 7-day cookie that lets you through.
# Leave unset to disable the bypass entirely. Was previously hardcoded in
# src/proxy.ts and is therefore in git history — use a NEW value here.
MAINTENANCE_PREVIEW_SECRET=your_random_preview_token_here

# ─── Security telemetry ─────────────────────────────────────────────────────
# High-severity security events (scanners, injection attempts, 404 sweeps,
# login bursts) post here. Throttled to one alert per IP+kind per 15 minutes.
# Create it in Discord: Channel Settings > Integrations > Webhooks.
DISCORD_SECURITY_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here
# Salt for hashing IPs in the security_events.ip_hash column. Any long random
# string; changing it later makes old hashes non-comparable to new ones.
SECURITY_IP_SALT=change_me_to_a_long_random_string

# ─── Assistify Support Chat ─────────────────────────────────────────────────
# Get your Widget ID from the Assistify dashboard (https://assistify.chat)
# Leave blank to disable the support chat widget entirely
NEXT_PUBLIC_ASSISTIFY_WIDGET_ID=your_assistify_widget_id_here

# ─── SERYX — reseller key generation (Rust + FiveM) ─────────────────────────
# Docs: https://seryx.gg/reseller/api-docs/
# Secret key ("sk_rsl_…") — SERVER ONLY, never prefix with NEXT_PUBLIC_.
# This is a PREPAID WALLET credential: anyone holding it can spend your balance,
# so treat it like a card number. Set it in Vercel → Settings → Environment
# Variables, and for local dev only in .env.local (never commit that file).
#
# Variants opt into Seryx delivery by setting shop_variants.seryx_game +
# seryx_plan_type (see supabase/migrations/seryx_delivery.sql). Everything else
# keeps delivering through reselling.pro.
#
# Delivery returns 402 when the wallet is empty — that fires a Discord alert via
# DISCORD_SECURITY_WEBHOOK_URL if configured, so top up before it runs dry.
SERYX_API_KEY=sk_rsl_your_seryx_reseller_key_here
# Optional override of the API base. No trailing slash — the client appends
# "/keys/generate". Leave unset to use the documented default.
SERYX_API_BASE=https://api.seryx.gg/api/v1/reseller
